{
  "name": "floorpulse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "cd ../backend && uv run python -m app.openapi_dump ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@tanstack/react-query": "^5",
    "i18next": "^25",
    "idb": "^8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7",
    "react-i18next": "^15",
    "react-router": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "fake-indexeddb": "^6",
    "globals": "^16",
    "jsdom": "^27",
    "openapi-typescript": "^7",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-pwa": "^1",
    "vitest": "^5"
  }
}
