# Copy to backend/.env (local dev) or export for docker compose. App settings are prefixed FP_.
FP_ENV=dev
# prod: postgresql+psycopg://floorpulse:secret@db:5432/floorpulse
FP_DATABASE_URL=sqlite:///./floorpulse.db
# Required in prod (>= 32 chars): python -c "import secrets; print(secrets.token_urlsafe(48))"
FP_SECRET_KEY=
# true behind HTTPS
FP_COOKIE_SECURE=false
FP_CORS_ORIGINS=["http://localhost:5173"]
FP_PUBLIC_BASE_URL=http://localhost:5173
FP_LOG_LEVEL=INFO
FP_LOG_JSON=true
FP_SCHEDULER_ENABLED=true
# Optional error reporting; also `uv add sentry-sdk`
FP_SENTRY_DSN=
FP_SMTP_HOST=
FP_SMTP_PORT=587
FP_SMTP_USER=
FP_SMTP_PASSWORD=
FP_SMTP_FROM=FloorPulse <no-reply@example.com>

# docker compose only
POSTGRES_PASSWORD=
FP_DOMAIN=localhost
